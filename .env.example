# ===== Runtime =====
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
CLIENT_DEV_PORT=8080

# ===== Local workspace (source development) =====
# Open directly without a Squabble login. Keep this mode on loopback only.
AUTH_MODE=local
TRUST_PROXY=false
LOCAL_APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LOCAL_AGENTS_MODE=native
# Reuse a specific existing workspace if this database contains multiple users.
# LOCAL_WORKSPACE_USER_ID=your-existing-user-id
# Use AUTH_MODE=account for username/password sessions. An unset backend mode
# retains account authentication; Docker continues to use account mode.

# ===== Logging =====
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# ===== Optional LLM (multi-agent analysis) =====
# Leave these empty for basic analysis, or use your own provider credentials.
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_FAST=doubao-lite-4k
DOUBAO_MODEL_SLOW=doubao-pro-32k

# ===== Source development (npm run dev) =====
# The Docker and desktop modes configure their own local database and secrets.
# For source development, provide your own local PostgreSQL 16 database and a
# private JWT secret of at least 16 characters, including in local mode.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/portfolio
# JWT_SECRET=replace-with-your-own-long-random-value
# SETTINGS_ENCRYPTION_KEY=replace-with-another-long-random-value
# REGISTER_ENABLED=true

# Opt-in rollout for Today / Research room / AI investment. Existing accounts require explicit adoption.
SQUABBLE_SIMPLE_EXPERIENCE=false

# ===== Optional Agent Telemetry export =====
# Local operational records work without Langfuse. Export is disabled by default.
# Enable only for an instance you operate; keys are server-only.
LANGFUSE_ENABLED=false
# LANGFUSE_BASE_URL=http://127.0.0.1:3001
# LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
# LANGFUSE_SECRET_KEY=sk-lf-replace-me
# Optional UI link to your Langfuse project; never include credentials in URLs.
# LANGFUSE_PROJECT_URL=http://127.0.0.1:3001/project/your-project-id
# Metadata-only export: no prompts, completions, holdings or tool arguments.
